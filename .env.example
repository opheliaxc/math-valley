# Copy to .env and adjust. Start with:
#   node --env-file-if-exists=.env server/index.ts
# Or set the same keys in ecosystem.config.cjs / your shell.

# HTTP
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Serve the Vite build (dist/) from the API process so the app and /api share one origin.
# Default: on when NODE_ENV=production. Set 0 to disable (API-only).
SERVE_STATIC=1
# STATIC_DIR=dist

# SQLite
# DB_PATH=server/data/math-valley.db
# BACKUP_DIR=server/data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
