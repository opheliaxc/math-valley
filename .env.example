# Copy to .env and adjust. Never commit .env.
#
# Local (no Docker):
#   node --env-file-if-exists=.env server/index.ts
#
# Docker Compose (recommended on a server):
#   cp .env.example .env
#   docker compose up -d --build

# HTTP
# Host port published by Compose, and the port the process listens on inside the container.
PORT=3066
# Must be 0.0.0.0 in Docker so the published port can reach the app.
HOST=0.0.0.0
NODE_ENV=production

# Serve the Vite build (dist/) from the API so the UI and /api share one origin.
# Default: on when NODE_ENV=production. Set 0 for API-only.
SERVE_STATIC=1
# Optional override (container default is /app/dist from the image).
# STATIC_DIR=dist

# SQLite paths
# Outside Docker (defaults if unset): server/data/math-valley.db and server/data/backups
# In Docker Compose these match the named volumes mounted at /data and /backups:
DB_PATH=/data/math-valley.db
BACKUP_DIR=/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
