{
  "name": "math-valley",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/index.ts",
    "start": "NODE_ENV=production SERVE_STATIC=1 node --env-file-if-exists=.env server/index.ts",
    "db:migrate": "node server/db/migrate.ts migrate",
    "db:status": "node server/db/migrate.ts status",
    "db:import-json": "node scripts/import-json.ts",
    "db:export-json": "node scripts/export-json.ts",
    "db:backup": "node server/db/backup.ts",
    "db:restore": "node server/db/restore.ts",
    "db:try-students": "node scripts/try-students-repo.mjs",
    "db:try-sqlite-store": "node scripts/try-sqlite-store.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "test:storage-contract": "node scripts/test-storage-contract.mjs",
    "test": "npm run test:storage && npm run test:storage-contract && npm run test:api",
    "test:api": "node scripts/test-api.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "framer-motion": "^13.4.0",
    "kysely": "^0.29.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
